# Скопируйте в .env и заполните. .env не коммитится.
BOT_TOKEN=
BOT_MODE=auto               # auto | polling | webhook (auto: webhook на Railway, polling локально)
WEBHOOK_BASE_URL=           # не нужен на Railway (берётся из RAILWAY_PUBLIC_DOMAIN)
WEBHOOK_SECRET=             # необязательно; по умолчанию выводится из BOT_TOKEN
PORT=8080

# Supabase → Settings → Database → Connection string → Session pooler (порт 5432)
# postgresql://postgres.<project_ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./dev.db
REDIS_URL=                  # пусто — состояние диалогов в памяти

ENCRYPTION_KEY=             # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANTHROPIC_API_KEY=          # ключ Claude API; пусто — ИИ-функции отключены
ADMIN_IDS=                  # Telegram ID администраторов через запятую
REGISTRATION_MODE=invite    # invite | open
LOG_LEVEL=INFO
